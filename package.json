{
  "name": "agentqa",
  "version": "1.0.0",
  "description": "Local-first AI-powered QA agent for web applications",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"bun run dev:web\" \"bun run dev:engine\"",
    "dev:web": "cd apps/web && bun run dev",
    "dev:engine": "cd apps/engine && bun run dev",
    "build": "bun run build:web && bun run build:engine",
    "build:web": "cd apps/web && bun run build",
    "build:engine": "cd apps/engine && bun run build",
    "test": "bun run test:engine",
    "test:engine": "cd apps/engine && bun run test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}