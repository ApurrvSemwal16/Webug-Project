# AgentQA Configuration

# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# AgentQA Server
AGENTQA_PORT=3001
NODE_ENV=production

# Demo Mode - uses deterministic actions for the included demo app
DEMO_MODE=true

# Agent Limits
MAX_ACTIONS=20
MAX_RUNTIME=120000
MAX_CONSECUTIVE_FAILURES=3
MAX_AI_CALLS=15

# Demo App
DEMO_APP_URL=http://demo-app:3000
DEMO_APP_PORT=3000

# Optional: OpenAI-compatible provider (for future use)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=